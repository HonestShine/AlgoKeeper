{
  "name": "algokeeper",
  "version": "0.1.0",
  "description": "AlgoKeeper - 本地优先的算法题解记录 + 间隔重复复习桌面应用",
  "main": "./out/main/index.js",
  "author": "AlgoKeeper",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "node scripts/db-note.js init",
    "db:migrate": "node scripts/db-note.js migrate"
  },
  "dependencies": {
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-sqlite3": "^13.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron@44.3.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
